GOOGLE_MAPS_API_KEY=your_key_here
PORT=3000

# Con npm start il server espone /api/config (e /config.js) con window.__ROAMY_CONFIG__ (chiave Google Maps).
# Su Vercel: Impostazioni progetto → Environment Variables → GOOGLE_MAPS_API_KEY (Production / Preview).
# Su GitHub Pages inserisci la chiave in config.js (non committare chiavi reali in pubblico).
